FLASK_ENV=development
PORT=3001
SECRET_KEY=dongstore_super_secret_key_2026_change_in_production
JWT_SECRET=dongstore_jwt_secret_key_2026_change_in_production
SECURE_API_KEY=replace_with_long_random_secret_min_32_chars
PAYMENTS_CALLBACK_SECRET=replace_with_hmac_secret_for_gateway_callback
FRONTEND_URL=http://localhost:5173

# CORS: app.py đã gộp FRONTEND_URL + danh sách mặc định (localhost/127.0.0.1 cổng 5173–5180).
# Chỉ cần CORS_ORIGINS khi muốn DANH SÁCH TÙY CHỈNH HOÀN TOÀN (sẽ thay thế default).
# Ví dụ production:
# CORS_ORIGINS=https://admin.example.com,http://localhost:5177

# ─── Firebase Realtime DB (Douyin License Server) ─────────────────────────────
# Dùng để tạo license key trên Firebase khi bán sản phẩm.
# Copy giá trị từ server Douyin (.env):
FIREBASE_URL=https://your-project.firebaseio.com
FIREBASE_AUTH=your_firebase_auth_secret

# ─── License Validation (port từ Douyin server) ───────────────────────────────
# Endpoint: POST /api/validate, GET /api/public-key, GET /api/update/latest
#
# 1. FERNET_KEY — symmetric key trả về client khi validate thành công.
#    Sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#    ⚠️ Phải KHỚP với FERNET_KEY trên Douyin server nếu client dùng chung.
FERNET_KEY=
#
# 2. SIGNING_PRIVATE_KEY_B64 — Ed25519 private key (32 bytes, base64).
#    Sinh bằng:
#      python -c "
#      import base64
#      from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#      k = Ed25519PrivateKey.generate()
#      print(base64.b64encode(k.private_bytes_raw()).decode())
#      "
#    ⚠️ Public key tương ứng phải được nhúng vào Desktop App để verify.
SIGNING_PRIVATE_KEY_B64=
#
# 3. ADMIN_KEY — bảo vệ các admin endpoint /api/admin/keys/* (header X-Admin-Key).
#    Đặt chuỗi bất kỳ, giữ bí mật.
ADMIN_KEY=dat_admin_key_bat_ky_day

# ─── Banking / VietQR ──────────────────────────────────────────────────────────
# Thông tin tài khoản nhận tiền (dùng cho VietQR tự động)
# Các ngân hàng được VietQR hỗ trợ: MB=970422, TPB=970448, VCB=970436, CTB=970405...
BANK_ID=970422
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=NGUYEN VAN A
# Template QR: UH8kzQZ (Quick Link), compact2, qr_only
VIETQR_TEMPLATE=UH8kzQZ

# ─── Thueapibank.vn auto-check ────────────────────────────────────────────────
# Dịch vụ tự động kiểm tra giao dịch Vietcombank qua thueapibank.vn
# Lấy thông tin từ thueapibank.vn/historyapivcbv3
THUEAPIBANK_USERNAME=
THUEAPIBANK_PASSWORD=
THUEAPIBANK_API_BASE=https://thueapibank.vn

# ─── PostgreSQL (aaPanel / cùng máy với backend) ─────────────────────────────
# Bắt buộc: dùng DATABASE_URL hoặc set đầy đủ PG_* (đặc biệt PG_PASSWORD).
# Trên aaPanel: Database name dong_store, user Dong_store, copy mật khẩu vào PG_PASSWORD.
#
# Cách 1 — từng biến:
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=dong_store
# PG_USER=Dong_store
# PG_PASSWORD=mat_khau_tu_aapanel
#
# Cách 2 — một dòng (URL-encode ký tự đặc biệt trong password):
# DATABASE_URL=postgresql://Dong_store:MAT_KHAU@localhost:5432/dong_store

# ─── Google OAuth (lấy từ Google Cloud Console) ───────────────────────────────
# 1. Vào https://console.cloud.google.com/apis/credentials
# 2. Tạo OAuth 2.0 Client ID (Web application)
# 3. Thêm Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# 4. Điền thông tin bên dưới
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ─── Admin account ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@dongstore.vn
ADMIN_PASSWORD=admin123
